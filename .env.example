MYSQL_ROOT_PASSWORD=replace-me
DB_PASSWORD=replace-me
JWT_SECRET=replace-with-at-least-32-random-characters
MINIO_ACCESS_KEY=interview-minio
MINIO_SECRET_KEY=replace-me
AI_CALLBACK_TOKEN=replace-me
# 默认关闭：不配置 Key 时使用内置的可解释离线评测器
AI_EVALUATION_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_ENDPOINT=/chat/completions
AI_MODEL=
AI_API_KEY=

# 本机端口冲突时取消注释并调整；容器之间仍使用标准端口通信
# LIGANG_MYSQL_PORT=13306
# LIGANG_REDIS_PORT=16379
# LIGANG_MINIO_PORT=19000
# LIGANG_MINIO_CONSOLE_PORT=19001
# LIGANG_BACKEND_PORT=18080
# LIGANG_FRONTEND_PORT=15173
